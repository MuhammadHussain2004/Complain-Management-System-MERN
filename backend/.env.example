PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/scms
# For MongoDB Atlas, use the connection string from "Connect your application"
# and add your own database name before the "?", e.g.:
# mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/scms?appName=Cluster0
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Initial admin account, created by `npm run seed:admin`
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@scms.com
ADMIN_PASSWORD=Admin@12345
